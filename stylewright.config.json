{
  "_comment": "Swap the entire `styleSource` block to target a different style repo (see README \u2192 'Using a different style source'). The harness logic never hardcodes Catppuccin \u2014 everything style-specific lives here.",
  "styleSource": {
    "id": "catppuccin",
    "repo": "catppuccin/userstyles",
    "preprocessor": "less",
    "outputExtension": ".user.less",
    "vendor": {
      "templateUrl": "https://raw.githubusercontent.com/catppuccin/userstyles/main/template/catppuccin.user.less",
      "libUrl": "https://userstyles.catppuccin.com/lib/lib.less",
      "templateFile": "template.user.less",
      "libFile": "lib.less",
      "rewriteImport": {
        "from": "https://userstyles.catppuccin.com/lib/lib.less",
        "to": "lib.less"
      },
      "placeholders": {
        "<website-domain>": "{domain}",
        "<port-name>": "{site}"
      },
      "startMarker": "/* Start styling your website here: */",
      "starterRules": [
        "body { background-color: @base !important; }",
        "a { color: @accent !important; }"
      ]
    },
    "variants": {
      "vars": {
        "lightFlavor": {
          "default": "latte",
          "options": [
            "latte",
            "frappe",
            "macchiato",
            "mocha"
          ]
        },
        "darkFlavor": {
          "default": "mocha",
          "options": [
            "latte",
            "frappe",
            "macchiato",
            "mocha"
          ]
        },
        "accentColor": {
          "default": "mauve",
          "options": [
            "rosewater",
            "flamingo",
            "pink",
            "mauve",
            "red",
            "maroon",
            "peach",
            "yellow",
            "green",
            "teal",
            "sky",
            "sapphire",
            "blue",
            "lavender",
            "subtext0"
          ]
        }
      },
      "verify": [
        {
          "label": "mocha-dark",
          "colorScheme": "dark",
          "vars": {
            "darkFlavor": "mocha",
            "accentColor": "mauve"
          }
        },
        {
          "label": "latte-light",
          "colorScheme": "light",
          "vars": {
            "lightFlavor": "latte",
            "accentColor": "mauve"
          }
        }
      ]
    },
    "palette": {
      "names": [
        "rosewater",
        "flamingo",
        "pink",
        "mauve",
        "red",
        "maroon",
        "peach",
        "yellow",
        "green",
        "teal",
        "sky",
        "sapphire",
        "blue",
        "lavender",
        "text",
        "subtext1",
        "subtext0",
        "overlay2",
        "overlay1",
        "overlay0",
        "surface2",
        "surface1",
        "surface0",
        "base",
        "mantle",
        "crust"
      ],
      "roleHints": {
        "page-background": [
          "base",
          "mantle",
          "crust"
        ],
        "raised-surface": [
          "surface0",
          "surface1",
          "surface2"
        ],
        "muted-decoration": [
          "overlay0",
          "overlay1",
          "overlay2"
        ],
        "body-text": [
          "text"
        ],
        "secondary-text": [
          "subtext0",
          "subtext1"
        ],
        "disabled-placeholder": [
          "overlay0",
          "overlay1"
        ],
        "interactive-accent": [
          "accent",
          "mauve",
          "blue",
          "sapphire",
          "lavender"
        ],
        "success": [
          "green",
          "teal"
        ],
        "warning": [
          "yellow",
          "peach"
        ],
        "error": [
          "red",
          "maroon"
        ]
      }
    },
    "automap": {
      "_comment": "name\u2192role table for automap (src/automap.mjs). Patterns are case-insensitive regexes matched against the var name after stripPrefix; first hit wins. 'skip' marks direction-ambiguous names (a site's 'white' means opposite things in latte vs mocha) and non-solid uses (shadows/overlays) \u2014 reported, never guessed. Convention note: only on_* is treated as contrast-on-color; X_foreground maps to the X role itself (bui convention: action_foreground = the blue used AS text). shadcn-style *-foreground vars carry bare HSL-triple values and fail the value gate, so the collision doesn't arise.",
      "stripPrefix": "^(bui_|ui_|theme_|color[-_])",
      "skip": [
        "(^|[-_])(white|black|gr[ae]y|blue|purple|violet|indigo|pink|teal|cyan|red|green|yellow|orange|transparent)([-_]|$|[0-9])",
        "shadow|overlay|backdrop|scrim|gradient|photo|image"
      ],
      "roles": [
        {
          "match": "(^|[-_])on[-_]",
          "role": "@crust"
        },
        {
          "match": "invert|inverse",
          "role": "@crust"
        },
        {
          "match": "success|constructive|confirm|positive|(^|[-_])ok([-_]|$)",
          "role": "@green"
        },
        {
          "match": "warning|caution|attention",
          "role": "@yellow"
        },
        {
          "match": "error|danger|destructive|negative|critical",
          "role": "@red"
        },
        {
          "match": "(^|[-_])info",
          "role": "@blue"
        },
        {
          "match": "accent|primary|brand|link|cta|action|highlight|selected|focus|active",
          "role": "@accent"
        },
        {
          "match": "inset|sunken|mantle|crust|(bg|background)[-_]?(alt|secondary)|secondary[-_]?(bg|background)",
          "role": "@mantle"
        },
        {
          "match": "card|paper|raised|surface|elevat|tile|panel|modal|popover|tooltip[-_]?(bg|background)",
          "role": "@surface0"
        },
        {
          "match": "(^|[-_])(bg|background|canvas|window|page)",
          "role": "@base"
        },
        {
          "match": "border|divider|separator|stroke|outline",
          "role": "@surface2"
        },
        {
          "match": "muted|hint|placeholder|disabled|subtext|tertiary|secondary",
          "role": "@subtext0"
        },
        {
          "match": "text|foreground|(^|[-_])fg([-_]|$)|heading|title|caption|icon",
          "role": "@text"
        }
      ],
      "scopeSelectors": [
        "&",
        "body",
        "[data-theme]",
        "[data-bui-theme]",
        "[data-color-mode]",
        "[data-mode]",
        "[class*=\"theme\" i]"
      ]
    }
  },
  "browser": {
    "channel": "chrome",
    "headed": true,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "deviceScaleFactor": 1,
    "storageStatePath": null,
    "navigationTimeoutMs": 45000,
    "settleMs": 1500
  },
  "iteration": {
    "maxRounds": 8,
    "screenshotFullPage": true
  }
}
